# BusKothay API — copy to apps/api/.env and edit.
# Nothing in this file is a secret. AWS credentials are never set here: the SDK
# takes them from the runtime provider chain (the App Runner instance role in the
# cloud, your own profile locally).

NODE_ENV=development

# Local default. App Runner expects 8080, matching the port in the Dockerfile.
PORT=3001

# memory  — local development and tests. Not durable; a restart loses everything.
# dynamodb — required in production. The process refuses to start in production
#            with memory persistence.
DATA_DRIVER=memory

AWS_REGION=ap-south-1
DYNAMODB_TABLE=buskothay-dev

# Local DynamoDB only (see compose.yaml). MUST be unset when talking to AWS.
# DYNAMODB_ENDPOINT=http://localhost:8000

# Comma-separated exact origins. In production this is the Amplify origin, and
# localhost is rejected.
CORS_ORIGINS=http://localhost:5173

# Resolved from the repository root. In the container this is /app/data/routes.
ROUTE_DATA_DIR=data/routes
DEFAULT_ROUTE_ID=ac24-patuli-howrah

LOG_LEVEL=info

# Private service credential shared only by the API and demo worker. Required
# for either simulator command. Generate at least 32 random characters and keep
# the real value out of Git.
# SIMULATOR_TOKEN=replace-with-a-long-random-private-value

# Browser account-session lifetime. Default is seven days.
SESSION_TTL_HOURS=168

# Optional live-traffic speed refresh. Leave false until it has been verified
# against the committed geometry.
TRAFFIC_REFRESH_ENABLED=false

# Number of proxy hops whose forwarding headers may be believed. 0 locally,
# 1 behind App Runner. Do not raise it to make an IP appear.
TRUST_PROXY_HOPS=0

# Create and join rate limits, per IP. Leave these unset in production: the
# defaults live in packages/shared/src/constants.ts. They exist as overrides so a
# browser-test run that legitimately creates many journeys is not throttled.
# RATE_LIMIT_CREATE_PER_MINUTE=6
# RATE_LIMIT_CREATE_BURST=3
# RATE_LIMIT_JOIN_PER_MINUTE=20
# RATE_LIMIT_JOIN_BURST=5
