# BusKothay web — copy to apps/web/.env.local and edit.
#
# Every VITE_* value below ends up in the built JavaScript and is public. A
# browser map key belongs here because it is public by design and is restricted
# by permitted actions, referrers and expiry. An AWS secret key, a backend
# capability, or any unrestricted credential does NOT belong here — or anywhere
# in this app.

# Local default. In production this must be the real https API origin; the build
# fails if it still points at localhost.
VITE_API_BASE_URL=http://localhost:3001

# Public Google Maps JavaScript API key. Restrict it to Maps JavaScript API,
# Routes API and this site's exact HTTP referrers in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Use DEMO_MAP_ID locally. Create a JavaScript map ID for production so advanced
# stop and bus markers work with the deployment's own map configuration.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
