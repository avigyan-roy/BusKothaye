{
  "name": "@buskothay/shared",
  "version": "0.1.0",
  "private": true,
  "description": "The one contract: Zod schemas, DTO types, tuning constants, and the bounded projection shared by API, web and simulator.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit false --emitDeclarationOnly"
  },
  "dependencies": {
    "@buskothay/geometry": "*",
    "zod": "^3.23.8"
  }
}
